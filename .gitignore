# Python bytecode and test/type/lint caches
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Virtual environments and local environment configuration
.venv/
venv/
env/
.env
.env.*
!.env.example

# Build and packaging output
build/
dist/
*.egg-info/

# Generated benchmark output; keep the results directory itself
results/*
!results/.gitkeep
reports/latest.json

# Editor and operating system files
.idea/
.vscode/
.DS_Store
Thumbs.db
